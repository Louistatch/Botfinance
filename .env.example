# ─────────────────────────────────────────────────────────────
# CreditCEP AI — Variables d'environnement
# Copiez ce fichier en `.env` et ajustez les valeurs.
# ─────────────────────────────────────────────────────────────

# ── Base de données PostgreSQL ──
POSTGRES_USER=creditcep
POSTGRES_PASSWORD=creditcep_secret
POSTGRES_DB=creditcep
# Utilisé par Prisma (dans Docker: host=postgres ; en local: host=localhost)
DATABASE_URL=postgresql://creditcep:creditcep_secret@postgres:5432/creditcep?schema=public

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Backend (NestJS) ──
NODE_ENV=development
BACKEND_PORT=3001
API_PREFIX=api

# ── Authentification JWT ──
JWT_SECRET=change_me_super_secret_key_prod
JWT_EXPIRES_IN=1d

# ── Bot WhatsApp (Baileys) ──
# Active/désactive le démarrage automatique du bot au boot du backend
WHATSAPP_ENABLED=true
# Répertoire de persistance de la session Baileys
WHATSAPP_AUTH_DIR=.baileys_auth
# Nom affiché de l'appareil
WHATSAPP_DEVICE_NAME=CreditCEP-AI

# ── Dashboard (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Comptes de démonstration (seed) ──
SEED_ADMIN_EMAIL=admin@creditcep.ai
SEED_DEFAULT_PASSWORD=ChangeMe123!
